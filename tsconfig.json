{
    "exclude": [
        "dist",
        "test",
        "docs"
    ],
    "compilerOptions": {
        "outDir": "dist",
        "declaration": true,
        "declarationDir": "dist",
        "target": "es2019",
        "strict": true,
        "importHelpers": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "lib": [
            "es2019"
        ]
    }
}